{
  "name": "toiloki",
  "productName": "Toiloki",
  "private": true,
  "version": "1.0.0",
  "description": "Toiloki - Local-First Desktop Utility Suite",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"electron .\"",
    "build": "tsc -b && vite build",
    "test": "node tests/migration.test.cjs && node tests/verify-all-engines.cjs && node tests/verify-new-engines.cjs && node tests/phase9-capabilities.test.cjs",
    "preview": "vite preview",
    "electron:start": "cross-env SERVE_DIST=1 electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.toiloki.app",
    "productName": "Toiloki",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "Toiloki"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Toiloki"
    }
  },
  "dependencies": {
    "@types/jszip": "^3.4.1",
    "adm-zip": "^0.5.16",
    "cronstrue": "^3.27.0",
    "diff": "^7.0.0",
    "exceljs": "^4.4.0",
    "exifreader": "^4.26.0",
    "fast-xml-parser": "^5.0.8",
    "jsonpath-plus": "^10.3.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.9.0",
    "mathjs": "^14.3.1",
    "pako": "^3.0.2",
    "papaparse": "^5.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.13.0",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
